server:
  port: 9800

spring:
  main:
    web-application-type: reactive
  application:
    name: pym-gateway
  
  # Настройка реактивного подключения к БД для авторизации
  r2dbc:
    url: r2dbc:postgresql://localhost:9803/pym_database?schema=auth_schema
    username: pym_user
    password: pym_password

  cloud:
    gateway:
      globalcors:
        cors-configurations:
          '[/**]':
            allowedOrigins: "http://localhost:3000"
            allowedMethods: [GET, POST, OPTIONS]
            allowedHeaders: "*"
      
      routes:
        # Основной маршрут до Go-сервиса (защищенный контур)
        - id: data_service_route
          uri: http://localhost:9801
          predicates:
            - Path=/api/v1/rules/**, /api/v1/forecast/**, /api/v1/webhooks/**
          filters:
            - JwtAuthenticationFilter
